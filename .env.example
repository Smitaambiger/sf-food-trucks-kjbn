APP_NAME=KJBN Food Trucks API
ENVIRONMENT=development
LOG_LEVEL=INFO

DATASF_BASE_URL=https://data.sfgov.org/resource/rqzj-sfat.json
# Optional: register for a free token at https://data.sfgov.org/profile/app_tokens
# Not required for this dataset at low request volume, but recommended to avoid throttling.
DATASF_APP_TOKEN=
DATASF_TIMEOUT_SECONDS=8.0
DATASF_MAX_RETRIES=3

CACHE_TTL_SECONDS=900
DEFAULT_RADIUS_KM=1.0
MAX_RADIUS_KM=10.0
MAX_RESULTS=50
